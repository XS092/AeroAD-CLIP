# archives; put large archives in GitHub Releases instead
*.zip
*.tar
*.tar.gz

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# NOTE: *.pth checkpoints are intentionally NOT ignored -
# they are part of this release. If a single file exceeds 50 MB,
# move it to a GitHub Release or use Git LFS instead.

# SAQ weights exceed GitHub's 100 MB per-file limit (~385 MB each).
# They are distributed as a GitHub Release asset instead: see README section 4.
checkpoints/*/SAQ/*.pth
checkpoints/*/GCT/*.pth
manifold/*.h5
